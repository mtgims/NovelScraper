[Unit]
Description=NovelScraper frontend (Next.js)
After=network-online.target novelscraper-backend.service
Wants=network-online.target novelscraper-backend.service

[Service]
Type=simple
WorkingDirectory=%h/NovelScraper/frontend
Environment=NODE_ENV=production
# node/npm are managed by mise; the shims are version-stable absolute paths.
Environment=PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
# Bound to 0.0.0.0 so your Tailscale (and LAN) devices can reach it. This serves
# the app AND proxies /api/* to the backend, so it's the only port anything
# connects to. Requires `npm run build` first.
ExecStart=%h/.local/share/mise/shims/npm run start -- -H 0.0.0.0 -p 3000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
