#!/usr/bin/env bash
# NovelScraper service helper. The one gotcha this exists to hide: the frontend
# runs as `next start`, which serves the *pre-built* .next/ — so after any
# frontend code change the build must be regenerated or the service crash-loops
# with "Could not find a production build". `ns restart` always rebuilds first.
#
# Usage:
#   ns              # rebuild frontend + restart both + verify   (same as restart)
#   ns restart      #   "
#   ns restart -n   # restart without rebuilding (fast; use when only backend changed)
#   ns start        # start both units
#   ns stop         # stop both units
#   ns status       # unit status + where to reach it
#   ns build        # rebuild the frontend only
#   ns logs [f|b]   # follow logs (frontend by default; b = backend)
set -euo pipefail

FRONTEND="$HOME/NovelScraper/frontend"
FE=novelscraper-frontend
BE=novelscraper-backend
PORT=3000

sc() { systemctl --user "$@"; }

build() {
  echo "› Building frontend…"
  ( cd "$FRONTEND" && npm run build >/tmp/ns-build.log 2>&1 ) || {
    echo "✗ Build failed. Last lines:"; tail -20 /tmp/ns-build.log; exit 1;
  }
  echo "  build ok"
}

verify() {
  echo "› Verifying…"
  for _ in $(seq 1 20); do
    [ "$(sc is-active "$FE")" = active ] && \
      curl -sf -o /dev/null "http://127.0.0.1:$PORT/" && break
    sleep 1
  done
  local fe be
  fe=$(sc is-active "$FE"); be=$(sc is-active "$BE")
  echo "  frontend: $fe   backend: $be"
  if [ "$fe" != active ]; then
    echo "✗ frontend not active — recent logs:"; sc --no-pager -n 15 status "$FE" || true; exit 1
  fi
  local health; health=$(curl -sf --max-time 5 "http://127.0.0.1:$PORT/api/health" || echo '(no response)')
  echo "  /api/health (proxied): $health"
  local ip; ip=$(tailscale ip -4 2>/dev/null | head -1 || true)
  [ -n "$ip" ] && echo "  reach it at: http://$ip:$PORT"
  echo "✓ up"
}

cmd=${1:-restart}
case "$cmd" in
  restart)
    [ "${2:-}" = -n ] || build
    echo "› Restarting services…"
    sc restart "$BE" "$FE"
    verify ;;
  start)   sc start "$BE" "$FE"; verify ;;
  stop)    sc stop "$FE" "$BE"; echo "✓ stopped" ;;
  build)   build; echo "  (run 'ns restart -n' to serve the new build)" ;;
  status)  sc --no-pager status "$FE" "$BE" || true ;;
  logs)    case "${2:-f}" in b|backend) sc -f -u "$BE" ;; *) sc -f -u "$FE" ;; esac ;;
  *) echo "unknown command: $cmd"; sed -n '5,17p' "$0"; exit 1 ;;
esac
