# Node, for the plugin host bundle under app/composeApp/pluginHost.
node_modules/

# local tooling scratch: editor/assistant config and worktrees. Never commit.
.claude/

# The built Android app, dropped here by every release build (see the
# copyApkToRoot task in app/composeApp/build.gradle.kts). A ~33MB binary that is
# reproducible from source, so it stays out of git — but it lives at the repo
# root so it is always in one predictable place to send to a phone.
/novelscraper.apk
/novelscraper-*.apk
# The Linux desktop app, dropped here by packageLinuxAppImage (~117MB).
/novelscraper-x86_64.AppImage

# Session handoff notes. Holds the server address, its SSH public key and
# operational detail that has no business in a shared repo — and `git add -A`
# would happily take it.
/CHAT-HANDOFF.md

# JVM crash reports and core files, written next to wherever the app was started.
/hs_err_pid*.log
/core.*
