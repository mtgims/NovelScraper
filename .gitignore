# Scraper runtime data — regenerable caches (data/cache, data/audio), generated
# EPUBs, covers, and the SQLite db. Bounded by the LRU cache pruner at runtime.
# NOTE: anchored to the repo root — an unanchored `data/` also matched the
# Android app's `.../com/novelscraper/app/data/` source package and silently
# left it untracked.
/data/
backend/data/

# TTS model files (large, downloaded on first use)
backend/models/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node / frontend (added later)
node_modules/
.next/

# NOTE: frontend/stubs/ is intentionally TRACKED (not ignored). It holds the
# empty onnxruntime-node stub that the package.json "overrides" points at via
# file:stubs/onnxruntime-node; without it a fresh `npm ci` can't resolve the
# dependency and the build fails.

# deploy secrets: .env holds the domain and the admin password
.env

# local tooling scratch: editor/assistant config and worktrees. Never commit.
.claude/

# The built Android app, dropped here by every release build (see the
# copyApkToRoot task in app/composeApp/build.gradle.kts). A ~33MB binary that is
# reproducible from source, so it stays out of git — but it lives at the repo
# root so it is always in one predictable place to send to a phone.
/novelscraper.apk
/novelscraper-*.apk

# Session handoff notes. Holds the server address, its SSH public key and
# operational detail that has no business in a shared repo — and `git add -A`
# would happily take it.
/CHAT-HANDOFF.md
