# --- NovelScraper deploy config — copy to .env and keep .env private ---
# cp .env.example .env  &&  edit  &&  docker compose up -d --build

# Public hostname. Must resolve to this server. Use DNS-only (Cloudflare "grey
# cloud") so Caddy can obtain Let's Encrypt certs directly — and to avoid the
# Cloudflare free-proxy 100 MB upload cap that would break large EPUB imports.
DOMAIN=novelscraper.com

# Email for Let's Encrypt (expiry notices).
ACME_EMAIL=you@example.com

# First-run admin account. Created ONLY when the database has no users yet
# (see backend/app/db.py bootstrap). Use a long, random password.
NOVELSCRAPER_ADMIN_USERNAME=admin
NOVELSCRAPER_ADMIN_PASSWORD=change-me-to-a-long-random-password

# Optional LRU cache caps in MB (backend/app/maintenance.py prunes at startup +
# hourly). Audio is regenerable narration cache; cache is scraped-HTML cache.
NOVELSCRAPER_MAX_CACHE_MB=500
NOVELSCRAPER_MAX_AUDIO_MB=1024
