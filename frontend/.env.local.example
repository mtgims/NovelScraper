# The frontend proxies /api/* to the backend (see next.config.mjs), so you
# usually need nothing here — it works over localhost, LAN, Tailscale, or a
# tunnel with no config and no CORS.
#
# Backend somewhere other than http://127.0.0.1:8000? Point the proxy at it
# (server-side, no CORS needed):
#   BACKEND_ORIGIN=http://127.0.0.1:8000
#
# Advanced: make the BROWSER call the backend directly (bypasses the proxy; then
# you must configure the backend's CORS allowlist):
#   NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
