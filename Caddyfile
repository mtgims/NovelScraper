# Automatic HTTPS (Let's Encrypt) + reverse proxy to the Next.js frontend, which
# in turn proxies /api/* to the backend. DOMAIN / ACME_EMAIL come from .env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	# The scrape-relay WebSocket must reach the backend directly: Next.js
	# rewrites (how the frontend proxies /api/*) don't forward WebSocket
	# upgrades. Caddy's reverse_proxy handles the upgrade natively.
	@relay path /api/relay
	handle @relay {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
