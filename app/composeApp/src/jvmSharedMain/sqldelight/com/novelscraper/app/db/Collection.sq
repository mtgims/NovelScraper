-- Library shelves. server_id links one imported from the server.
CREATE TABLE collection (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    sort_order INTEGER NOT NULL DEFAULT 0,
    server_id INTEGER UNIQUE,
    -- The shelf's name in sync: srv:<server id>, or a random id.
    sync_key TEXT
);

CREATE UNIQUE INDEX collection_sync_key ON collection(sync_key);

CREATE TABLE book_collection (
    book_id INTEGER NOT NULL REFERENCES book(id) ON DELETE CASCADE,
    collection_id INTEGER NOT NULL REFERENCES collection(id) ON DELETE CASCADE,
    PRIMARY KEY (book_id, collection_id)
);

selectAll:
SELECT * FROM collection ORDER BY sort_order, id;

selectByServerId:
SELECT * FROM collection WHERE server_id = ?;

insert:
INSERT INTO collection (name, sort_order, server_id, sync_key) VALUES (?, ?, ?, ?);

selectBySyncKey:
SELECT * FROM collection WHERE sync_key = ?;

setSortOrder:
UPDATE collection SET sort_order = ? WHERE id = ?;

removeBook:
DELETE FROM book_collection WHERE book_id = ? AND collection_id = ?;

lastInsertId:
SELECT last_insert_rowid();

rename:
UPDATE collection SET name = ? WHERE id = ?;

delete:
DELETE FROM collection WHERE id = ?;

maxSortOrder:
SELECT coalesce(max(sort_order), 0) FROM collection;

memberships:
SELECT * FROM book_collection;

ofBook:
SELECT collection_id FROM book_collection WHERE book_id = ?;

add:
INSERT OR IGNORE INTO book_collection (book_id, collection_id) VALUES (?, ?);

clearBook:
DELETE FROM book_collection WHERE book_id = ?;

-- Drop a novel from the server-linked shelves only (before re-applying the
-- server's list), keeping it on shelves that exist only on this device.
clearServerShelves:
DELETE FROM book_collection
WHERE book_id = ? AND collection_id IN (SELECT id FROM collection WHERE server_id IS NOT NULL);

selectServerLinked:
SELECT * FROM collection WHERE server_id IS NOT NULL;
