-- Sync through a folder in the user's own cloud storage (FolderSync): each
-- device numbers the batches it writes, and remembers how far it has read
-- every other device's.
ALTER TABLE sync_state ADD COLUMN out_seq INTEGER NOT NULL DEFAULT 0;
ALTER TABLE sync_state ADD COLUMN snap_seq INTEGER NOT NULL DEFAULT 0;

CREATE TABLE sync_peer (
    device TEXT NOT NULL PRIMARY KEY,
    seq INTEGER NOT NULL
);
