-- Changes to server novels and collections made on this device, waiting to be
-- sent to the server (in order) the next time it can be reached. kind names the
-- call (see ServerOutbox), target is the server's id of the novel or collection
-- it applies to, and body is the request's JSON.
CREATE TABLE server_outbox (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    kind TEXT NOT NULL,
    target INTEGER NOT NULL,
    body TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

add:
INSERT INTO server_outbox (kind, target, body, created_at) VALUES (?, ?, ?, ?);

selectAll:
SELECT * FROM server_outbox ORDER BY id;

count:
SELECT count(*) FROM server_outbox;

delete:
DELETE FROM server_outbox WHERE id = ?;
