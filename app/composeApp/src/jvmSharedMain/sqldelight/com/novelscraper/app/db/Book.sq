-- A novel the app knows about. Two origins:
--   source    read from its site through an extension: plugin_id + path
--   imported  read out of an EPUB on this device: neither, and no sync_key,
--             because an imported novel stays on the device that imported it
-- A source novel gets a row as soon as it is opened from Browse, with
-- in_library = 0; "Add to library" sets it to 1. Rows outside the library that
-- have not been opened for a while are pruned.
--
-- server_id / server_meta are left over from when the server stored novels. It
-- does not any more, they are always NULL, and nothing reads them; SQLite before
-- 3.35 cannot drop a column, so they stay until the table is next rebuilt.
CREATE TABLE book (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plugin_id TEXT,
    path TEXT,
    server_id INTEGER UNIQUE,
    server_meta TEXT,
    title TEXT NOT NULL,
    author TEXT NOT NULL DEFAULT '',
    cover TEXT,
    summary TEXT NOT NULL DEFAULT '',
    genres TEXT NOT NULL DEFAULT '',
    status TEXT NOT NULL DEFAULT '',
    -- What to show under the title: the source's name, or the server's site.
    site TEXT NOT NULL DEFAULT '',
    web_url TEXT,
    rating INTEGER,
    in_library INTEGER NOT NULL DEFAULT 0,
    sort_order INTEGER NOT NULL DEFAULT 0,
    added_at INTEGER NOT NULL DEFAULT 0,
    opened_at INTEGER NOT NULL DEFAULT 0,
    -- The resume point: the chapter last opened and how far down it (0..1).
    last_chapter_id INTEGER,
    scroll REAL NOT NULL DEFAULT 0,
    -- When the chapter list was last fetched from the source or server (0 = never).
    checked_at INTEGER NOT NULL DEFAULT 0,
    -- The novel's name in sync: srv:<server id>, or src:<plugin id><TAB><path>.
    sync_key TEXT,
    -- The resume point's sentence (in the chapter's sentence split), which
    -- places it the same on every device and screen; null if not known.
    sentence INTEGER,
    UNIQUE (plugin_id, path)
);

CREATE UNIQUE INDEX book_sync_key ON book(sync_key);

selectById:
SELECT * FROM book WHERE id = ?;

selectBySource:
SELECT * FROM book WHERE plugin_id = ? AND path = ?;

-- The library grid, with the counts it shows.
selectLibrary:
SELECT b.*,
    (SELECT count(*) FROM chapter c WHERE c.book_id = b.id) AS chapter_count,
    (SELECT count(*) FROM chapter c WHERE c.book_id = b.id AND c.read = 0) AS unread_count,
    (SELECT count(*) FROM chapter c JOIN chapter_content cc ON cc.chapter_id = c.id
        WHERE c.book_id = b.id AND cc.kept = 1) AS downloaded_count
FROM book b
WHERE b.in_library = 1
ORDER BY b.sort_order, b.id;

insertSource:
INSERT INTO book (plugin_id, path, title, author, cover, site, web_url, opened_at, sync_key)
VALUES (:plugin_id, :path, :title, :author, :cover, :site, :web_url, :opened_at, 'src:' || :plugin_id || char(9) || :path);

-- A novel imported from an EPUB here. No plugin to fetch from, and no sync key:
-- the file is on this device only, so the other devices have nothing to show.
insertLocal:
INSERT INTO book (title, author, cover, site, summary, in_library, sort_order, added_at, opened_at, checked_at)
VALUES (:title, :author, :cover, 'Imported', :summary, 1, :sort_order, :added_at, :added_at, :added_at);

selectBySyncKey:
SELECT * FROM book WHERE sync_key = ?;

-- What sync shares: the novels in the library that came from a source.
selectSyncable:
SELECT id FROM book WHERE sync_key IS NOT NULL AND in_library = 1;

setSentence:
UPDATE book SET sentence = ? WHERE id = ?;

lastInsertId:
SELECT last_insert_rowid();

updateSourceMeta:
UPDATE book SET title = ?, author = ?, cover = ?, summary = ?, genres = ?, status = ?, web_url = ?
WHERE id = ?;

setInLibrary:
UPDATE book SET in_library = ?, added_at = ?, sort_order = ? WHERE id = ?;

setRating:
UPDATE book SET rating = ? WHERE id = ?;

setSortOrder:
UPDATE book SET sort_order = ? WHERE id = ?;

maxSortOrder:
SELECT coalesce(max(sort_order), 0) FROM book WHERE in_library = 1;

setOpened:
UPDATE book SET opened_at = ? WHERE id = ?;

setResume:
UPDATE book SET last_chapter_id = ?, scroll = ? WHERE id = ?;

setCheckedAt:
UPDATE book SET checked_at = ? WHERE id = ?;

delete:
DELETE FROM book WHERE id = ?;

-- Novels looked at in Browse but never added, untouched since the cutoff and
-- with nothing downloaded.
pruneUnused:
DELETE FROM book
WHERE in_library = 0 AND opened_at < ?
  AND id NOT IN (SELECT c.book_id FROM chapter c JOIN chapter_content cc ON cc.chapter_id = c.id WHERE cc.kept = 1);

-- The resume point as a chapter position.
resume:
SELECT b.scroll, b.sentence, c.position, c.path FROM book b LEFT JOIN chapter c ON c.id = b.last_chapter_id WHERE b.id = ?;
